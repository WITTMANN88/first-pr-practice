  </data>
  <data name="Tweak_BitLocker_Title" xml:space="preserve">
    <value>BitLocker</value>
  </data>
  <data name="Tweak_BitLocker_Desc" xml:space="preserve">
    <value>Turns off BitLocker encryption on all volumes via WMI (Win32_EncryptableVolume).</value>
  </data>
  <data name="Tweak_DriverUpdates_Title" xml:space="preserve">
    <value>Driver updates</value>
  </data>
  <data name="Tweak_DriverUpdates_Desc" xml:space="preserve">
    <value>Stops Windows Update from force-installing drivers (group policies).</value>
  </data>
  <data name="Tweak_Hibernation_Title" xml:space="preserve">
    <value>Hibernation</value>
  </data>
  <data name="Tweak_Hibernation_Desc" xml:space="preserve">
    <value>Turns off hibernation with powercfg -h off (frees hiberfil.sys).</value>
  </data>
  <data name="Tweak_Animations_Title" xml:space="preserve">
    <value>Windows animations</value>
  </data>
  <data name="Tweak_Animations_Desc" xml:space="preserve">
    <value>Turns off all UI animations and transparency. Requires restarting Explorer.</value>
  </data>
  <data name="Tweak_MenuShowDelay_Title" xml:space="preserve">
    <value>MenuShowDelay</value>
  </data>
  <data name="Tweak_MenuShowDelay_Desc" xml:space="preserve">
    <value>Sets MenuShowDelay=0 so context menus open instantly.</value>
  </data>
  <data name="Tweak_Mpo_Title" xml:space="preserve">
    <value>MPO (Multi-Plane Overlay)</value>
  </data>
  <data name="Tweak_Mpo_Desc" xml:space="preserve">
    <value>Turns off MPO (OverlayTestMode=5 under Dwm). Helps with flicker and artifacts.</value>
  </data>
  <data name="Tweak_PowerThrottling_Title" xml:space="preserve">
    <value>Power Throttling</value>
  </data>
  <data name="Tweak_PowerThrottling_Desc" xml:space="preserve">
    <value>Turns off power throttling of background processes globally (PowerThrottlingOff=1).</value>
  </data>
  <data name="Tweak_Hags_Title" xml:space="preserve">
    <value>HAGS (hardware GPU scheduling)</value>
  </data>
  <data name="Tweak_Hags_Desc" xml:space="preserve">
    <value>Turns on Hardware-accelerated GPU Scheduling (HwSchMode=2). Requires a restart.</value>
  </data>
  <data name="Tweak_NetworkThrottling_Title" xml:space="preserve">
    <value>NetworkThrottlingIndex</value>
  </data>
  <data name="Tweak_NetworkThrottling_Desc" xml:space="preserve">
