<Project Sdk="Microsoft.NET.Sdk">

  <!-- OS-independent core of STAKEOUT: log encryption, rollback engine and its
       JSON persistence, UWP catalogue, notifications, localization.
       Deliberately plain net8.0 with no WPF / Windows-only dependencies, so it
       can be unit-tested on any OS (see STAKEOUT.Tests). Windows-specific code
       (real registry, WMI, dialogs) lives in the app behind the interfaces
       declared here (IRegistryAccess, IUiDispatcher, IDialogService). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Stakeout</RootNamespace>
    <AssemblyName>STAKEOUT.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Russian is the neutral (default) language compiled into this assembly;
         other languages ship as satellite assemblies (e.g. en/STAKEOUT.Core.resources.dll).
         Adding a language = adding Localization/Strings.<culture>.resx. -->
    <NeutralLanguage>ru</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Strongly typed accessor generated by MSBuild at build time (no
         Visual Studio designer file needed). RootNamespace + folder
         ("Stakeout" + "Localization") must equal StronglyTypedNamespace, or the
         generated ResourceManager base name will not match the manifest name. -->
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedNamespace>Stakeout.Localization</StronglyTypedNamespace>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.g.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="STAKEOUT.Tests" />
  </ItemGroup>

</Project>
