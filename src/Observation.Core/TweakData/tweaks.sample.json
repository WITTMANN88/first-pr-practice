    "verify": { "type": "handler", "handlerId": "BrowserPerformance" },
    "revert": { "type": "restore-previous" }
  },
  {
    "id": "privacy.advertising",
    "tab": "privacy",
    "group": { "ru": "Телеметрия и данные", "en": "Telemetry & data" },
    "name": { "ru": "Отключить рекламный ID", "en": "Turn off advertising ID" },
    "description": {
      "ru": "Запрещает приложениям использовать рекламный идентификатор Windows для персонализации рекламы.",
      "en": "Prevents apps from using the Windows advertising identifier for ad personalization."
    },
    "severity": "safe",
    "controlType": "toggle",
    "requiresReboot": false,
    "applicability": { "type": "always" },
    "apply": {
      "type": "registry",
      "hive": "HKCU",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo",
      "value": "Enabled",
      "valueType": "DWord",
      "onData": 0,
      "offData": 1
    },
    "verify": { "type": "registry-read", "matchesApply": true },
    "revert": { "type": "restore-previous" }
  },
  {
    "id": "privacy.diagtrack",
    "tab": "privacy",
    "group": { "ru": "Телеметрия и данные", "en": "Telemetry & data" },
    "name": { "ru": "Отключить телеметрию (DiagTrack)", "en": "Disable telemetry (DiagTrack)" },
    "description": {
      "ru": "Останавливает и отключает службу диагностических данных DiagTrack и минимизирует уровень телеметрии через политику AllowTelemetry. На изданиях, отличных от Enterprise/Education, минимальный уровень телеметрии, который реально принимает Windows, может быть выше нуля.",
      "en": "Stops and disables the DiagTrack diagnostics service and sets telemetry to the minimum via the AllowTelemetry policy. On editions other than Enterprise/Education, the minimum level Windows actually accepts may be above zero."
    },
    "severity": "safe",
    "controlType": "toggle",
    "requiresReboot": false,
    "applicability": { "type": "always" },
    "apply": { "type": "handler", "handlerId": "DiagTrackOff" },
    "verify": { "type": "handler", "handlerId": "DiagTrackOff" },
    "revert": { "type": "best-effort" }
  },
