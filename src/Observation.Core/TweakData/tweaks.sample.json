[
  {
    "id": "perf.gamemode",
    "tab": "perf",
    "group": { "ru": "Питание и режимы", "en": "Power & modes" },
    "name": { "ru": "Режим игры (Game Mode)", "en": "Game Mode" },
    "description": {
      "ru": "Приоритизирует ресурсы CPU/GPU для игры в полноэкранном режиме.",
      "en": "Prioritizes CPU/GPU resources for a fullscreen game."
    },
    "severity": "safe",
    "controlType": "toggle",
    "requiresReboot": false,
    "applicability": { "type": "always" },
    "apply": { "type": "handler", "handlerId": "GameModeToggle" },
    "verify": { "type": "handler", "handlerId": "GameModeToggle" },
    "revert": { "type": "restore-previous" }
  },
  {
    "id": "perf.hags",
    "tab": "perf",
    "group": { "ru": "GPU и экран", "en": "GPU & display" },
    "name": { "ru": "Аппаратное планирование GPU (HAGS)", "en": "Hardware-accelerated GPU Scheduling (HAGS)" },
    "description": {
      "ru": "Передаёт часть планирования очереди GPU видеокарте напрямую. Эффект зависит от драйвера и игры — где-то плюс к FPS/задержке, где-то нет разницы.",
      "en": "Hands part of GPU queue scheduling directly to the video card. Effect depends on driver and game — helps FPS/latency in some, no difference in others."
    },
    "severity": "situational",
    "controlType": "toggle",
    "requiresReboot": true,
    "applicability": { "minBuild": 18362 },
    "apply": {
      "type": "registry",
      "hive": "HKLM",
      "path": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
      "value": "HwSchMode",
      "valueType": "DWord",
      "onData": 2,
      "offData": 1
    },
    "verify": { "type": "registry-read", "matchesApply": true },
    "revert": { "type": "restore-previous" }
  },
  {
    "id": "perf.xboxdvr",
    "tab": "perf",
