<Window x:Class="Observation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Observation"
        Height="720" Width="1180" MinHeight="560" MinWidth="820"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Color.Bg}">

    <!--
        Безрамочное окно с ресайзом через WindowChrome (см. «Хранение данных, окно,
        локализация» в плане). Каркас: титлбар/сайдбар/контент — без пиксель-точной
        стилизации макета (декоративные SVG, фоновая иллюстрация, шрифты Cinzel/IBM Plex,
        анимации) — это отдельный, более поздний проход по договорённости.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WinBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Color.TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Color.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Color.TextMuted}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="9,9,9,9"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Color.Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Color.Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Color.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarStyle" TargetType="Border">
            <Setter Property="Width" Value="220"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Width" Value="64"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- titlebar -->
        <Border Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent"
                BorderBrush="{StaticResource Color.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="OBSERVATION" VerticalAlignment="Center"
                           Foreground="{StaticResource Color.TextMuted}" FontWeight="SemiBold" FontSize="11"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton Content="RU" GroupName="Lang" IsChecked="True" Margin="0,0,4,0"
                                 Command="{Binding SetLanguageCommand}" CommandParameter="ru"/>
                    <RadioButton Content="EN" GroupName="Lang"
                                 Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                </StackPanel>

                <Button Grid.Column="3" Content="&#x2013;" Style="{StaticResource WinBtnStyle}"
                        Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="4" Content="&#x25A2;" Style="{StaticResource WinBtnStyle}"
                        Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="5" Content="&#x2715;" Style="{StaticResource WinBtnStyle}"
                        Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SidebarStyle}"
                    Background="{StaticResource Color.SurfaceSolid}"
                    BorderBrush="{StaticResource Color.Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,14,10,14">

                    <!-- Экран About из макета (открывается кликом по brand) сюда не переехал —
                         не входит в этот архитектурный проход, появится вместе со стилизацией. -->
                    <Border DockPanel.Dock="Top" Padding="8,10,8,16" Margin="0,0,0,10"
                            BorderBrush="{StaticResource Color.Border}" BorderThickness="0,0,0,1">
                        <TextBlock Foreground="{StaticResource Color.Text}" FontWeight="SemiBold" FontSize="13"
                                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=AppTitle}"/>
                    </Border>

                    <Button DockPanel.Dock="Bottom" Content="&#x21C6;" HorizontalAlignment="Left"
                            Command="{Binding ToggleSidebarCommand}"
                            Background="Transparent" BorderBrush="{StaticResource Color.BorderStrong}" BorderThickness="1"
                            Foreground="{StaticResource Color.TextMuted}" Padding="8" Cursor="Hand"/>

                    <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource NavListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedTextMulti}">
                                            <Binding Path="LocalizationKey"/>
                                            <Binding Source="{StaticResource Localization}" Path="CurrentLanguage"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentTab}" Margin="26,22,26,22"/>
        </Grid>
    </Grid>
</Window>
