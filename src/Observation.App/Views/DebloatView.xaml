<UserControl x:Class="Observation.App.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        «Деблоат и UWP»: обычные твики (Brave/Edge/OneDrive — из TweakLibrary, тот же
        макет группы/severity/тумблера, что в TweakListView) сверху, реальный скан
        установленных UWP-пакетов (см. план, «Сканирование UWP-приложений») снизу —
        динамический список, не строчки из JSON-реестра (см. DebloatTabViewModel).
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding GroupName}" Foreground="{StaticResource Color.TextMuted}"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Color.SurfaceSolid}"
                                                BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Color.TextMuted}"
                                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                                        BorderThickness="1" CornerRadius="100" Padding="8,2"
                                                        BorderBrush="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}">
                                                    <TextBlock Text="{Binding SeverityLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                                               Foreground="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                </Border>

                                                <ToggleButton Grid.Column="2" IsChecked="{Binding IsOn}"
                                                              Style="{StaticResource SwitchToggleStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}" Margin="0,4,0,10"
                       Text="Установленные UWP-приложения"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ScanMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource Color.TextMuted}" FontSize="12"/>

                <Button Grid.Column="1" Padding="14,7" Cursor="Hand" BorderThickness="1"
                        BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                        Command="{Binding ScanCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Сканировать"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Content" Value="Сканирую…"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding UwpPackages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Color.SurfaceSolid}"
                                BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="13"/>
                                    <TextBlock Text="{Binding Publisher}" Foreground="{StaticResource Color.TextMuted}" FontSize="10.5"/>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Color.Danger}" FontSize="10.5"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                                </StackPanel>

                                <Button Grid.Column="1" Padding="12,6" Cursor="Hand" BorderThickness="1" VerticalAlignment="Center"
                                        BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding IsRemoving, Converter={StaticResource InverseBool}}"
                                        Content="Удалить"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
