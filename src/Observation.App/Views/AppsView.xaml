<UserControl x:Class="Observation.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        «Установка программ»: компоненты Windows (тумблеры из TweakLibrary, как везде)
        сверху, каталог winget по категориям и сборка рантаймов снизу (см. план,
        «Установка программ — техническая последовательность») — разовые установки,
        не тумблеры (см. AppsTabViewModel).
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding GroupName}" Foreground="{StaticResource Color.TextMuted}"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Color.SurfaceSolid}"
                                                BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                                                CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                                            <Grid>
                                                <Rectangle Width="3" HorizontalAlignment="Left"
                                                           Fill="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                <Grid Margin="17,12,14,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Color.TextMuted}"
                                                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                                               Text="{Binding SeverityLabel}"
                                                               Foreground="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>

                                                    <ToggleButton Grid.Column="2" IsChecked="{Binding IsOn}"
                                                                  Style="{StaticResource SwitchToggleStyle}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}"
                           Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=AppsWingetHeader}"/>
                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.Danger}" Margin="8,0,0,0">
                    <Run Text="— "/>
                    <Run Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=AppsWingetMissing}"/>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WingetAvailable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.TextMuted}"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="10.5" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Color.SurfaceSolid}"
                                                BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}"
                                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Padding="10,4" Cursor="Hand" BorderThickness="1"
                                                        BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Content"
                                                                    Value="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=AppsInstallBtn}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Installing">
                                                                    <Setter Property="Content"
                                                                            Value="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=AppsInstallingBtn}"/>
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Installed">
                                                                    <Setter Property="Content"
                                                                            Value="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=AppsInstalledBtn}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                    <Setter Property="Content"
                                                                            Value="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=AppsRetryBtn}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Color.Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button HorizontalAlignment="Left" Padding="14,7" Cursor="Hand" BorderThickness="1" Margin="0,4,0,14"
                    BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                    Command="{Binding InstallRuntimeBundleCommand}"
                    Content="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=AppsRuntimeBundleBtn}"/>

            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}" Margin="0,0,0,8"
                       Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=AppsLogHeader}"/>
            <ItemsControl ItemsSource="{Binding Log}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                                   Foreground="{StaticResource Color.TextMuted}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
