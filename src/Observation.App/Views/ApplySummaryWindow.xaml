<Window x:Class="Observation.App.Views.ApplySummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Observation" Icon="/Assets/AppIcon.ico" Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Color.Bg}" FontFamily="{StaticResource Font.Body}">
    <!--
        «Экран сводки перед применением» из плана — раньше конфликты показывались отдельным
        MessageBox, а сама сводка (список по группам + чекбокс «понимаю риски») из макета
        не была перенесена вовсе. Модальное окно, как AboutWindow — тот же паттерн.
    -->
    <Border Margin="12" Background="{StaticResource Color.SurfaceSolid}"
            BorderBrush="{StaticResource Color.BorderStrong}" BorderThickness="1" CornerRadius="12">
        <StackPanel Margin="22,20,22,18">
            <TextBlock Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=SummaryTitle}"
                       FontFamily="{StaticResource Font.Display}" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource Color.Text}" Margin="0,0,0,14"/>

            <Border Padding="12,10" CornerRadius="8" Background="#1AE2572C" BorderBrush="#59E2572C" BorderThickness="1" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=SummaryConflictTitle}"
                               FontWeight="SemiBold" Foreground="{StaticResource Color.Danger}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding ConflictMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource Color.Text}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding TabName}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                                           Foreground="{StaticResource Color.TextMuted}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SeverityLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Padding="10,8" CornerRadius="8" Background="#1AE2572C" BorderBrush="#59E2572C" BorderThickness="1" Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RequiresAcknowledgement}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding AcknowledgeRisky}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Color.Text}" FontSize="11.5"
                               Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=SummaryAckText}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Padding="16,7" Cursor="Hand" BorderThickness="1"
                        BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                        Command="{Binding CancelCommand}"
                        Content="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=SummaryCancel}"/>
                <Button Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ConfirmCommand}"
                        Content="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=SummaryConfirm}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
