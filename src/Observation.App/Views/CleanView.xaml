<UserControl x:Class="Observation.App.Views.CleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        «Очистка системы»: обычные твики (Reserved Storage — из TweakLibrary, тот же макет,
        что в TweakListView) сверху, разовые действия очистки (temp/WU-кэш/кэш Chrome —
        ScriptItemViewModel, тот же макет карточки, что в ScriptsView) снизу — см. CleanTabViewModel.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding GroupName}" Foreground="{StaticResource Color.TextMuted}"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Color.SurfaceSolid}"
                                                BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                                                CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                                            <Grid>
                                                <Rectangle Width="3" HorizontalAlignment="Left"
                                                           Fill="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                <Grid Margin="17,12,14,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Color.TextMuted}"
                                                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                                               Text="{Binding SeverityLabel}"
                                                               Foreground="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>

                                                    <Grid Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center"
                                                          Visibility="{Binding InfoText, Converter={StaticResource NullOrEmptyToVisibility}}">
                                                        <ToggleButton x:Name="InfoToggle" Style="{StaticResource InfoToggleButtonStyle}"/>
                                                        <Popup IsOpen="{Binding IsChecked, ElementName=InfoToggle, Mode=TwoWay}" StaysOpen="False"
                                                               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                                            <Border Style="{StaticResource InfoPopupBorderStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=InfoWhatTitle}"
                                                                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                                                               Foreground="{StaticResource Color.TextMuted}" Margin="0,0,0,6"/>
                                                                    <TextBlock Text="{Binding InfoText}" Foreground="{StaticResource Color.Text}"
                                                                               FontSize="11.5" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>

                                                    <ToggleButton Grid.Column="3" IsChecked="{Binding IsOn}"
                                                                  Style="{StaticResource SwitchToggleStyle}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}" Margin="0,4,0,10"
                       Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=CleanActionsHeader}"/>

            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Color.SurfaceSolid}"
                                BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,0,10" ClipToBounds="True">
                            <Grid>
                                <Rectangle Width="3" HorizontalAlignment="Left"
                                           Fill="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>
                                <StackPanel Margin="17,12,14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="13"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Color.TextMuted}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                                   Text="{Binding SeverityLabel}"
                                                   Foreground="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>

                                        <Button Grid.Column="2" Padding="14,7" Cursor="Hand" BorderThickness="1" VerticalAlignment="Center"
                                                BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                                                Command="{Binding RunCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content"
                                                            Value="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=ScriptRunBtn}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Content"
                                                                    Value="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=ScriptRunningBtn}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Log}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                                                           Foreground="{StaticResource Color.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
