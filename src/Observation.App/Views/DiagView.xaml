<UserControl x:Class="Observation.App.Views.DiagView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        «Диагностика и драйверы»: тумблер классического меню F8 (из TweakLibrary) сверху,
        текущая загрузка DPC/прерываний (честная замена «задержки в мкс» — см.
        PowerShellDpcActivitySampler) и версия драйвера видеокарты со ссылкой на страницу
        вендора, реальный скан проблемных устройств (read-only, «искать в интернете» вместо
        «исправить» — см. DiagTabViewModel/PowerShellProblemDeviceScanner) и быстрые
        ссылки на системные GUI-инструменты снизу.
    -->
    <UserControl.Resources>
        <!-- Карточка быстрой ссылки (иконка + подпись) — как .linkbtn в макете, вместо
             прежних кнопок с одним текстом (честно отмеченный пробел в прошлом проходе). -->
        <Style x:Key="QuickLinkButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Color.Border}"/>
            <Setter Property="Background" Value="{StaticResource Color.SurfaceSolid}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding GroupName}" Foreground="{StaticResource Color.TextMuted}"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Color.SurfaceSolid}"
                                                BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                                                CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                                            <Grid>
                                                <Rectangle Width="3" HorizontalAlignment="Left"
                                                           Fill="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                <Grid Margin="17,12,14,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Color.TextMuted}"
                                                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                                               Text="{Binding SeverityLabel}"
                                                               Foreground="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>

                                                    <Grid Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center"
                                                          Visibility="{Binding InfoText, Converter={StaticResource NullOrEmptyToVisibility}}">
                                                        <ToggleButton x:Name="InfoToggle" Style="{StaticResource InfoToggleButtonStyle}"/>
                                                        <Popup IsOpen="{Binding IsChecked, ElementName=InfoToggle, Mode=TwoWay}" StaysOpen="False"
                                                               Placement="Left" HorizontalOffset="-6" AllowsTransparency="True" PopupAnimation="Fade">
                                                            <Border Style="{StaticResource InfoPopupBorderStyle}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=InfoWhatTitle}"
                                                                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                                                               Foreground="{StaticResource Color.TextMuted}" Margin="0,0,0,6"/>
                                                                    <TextBlock Text="{Binding InfoText}" Foreground="{StaticResource Color.Text}"
                                                                               FontSize="11.5" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>

                                                    <ToggleButton Grid.Column="3" IsChecked="{Binding IsOn}"
                                                                  Style="{StaticResource SwitchToggleStyle}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}" Margin="0,4,0,10"
                       Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagDpcHeader}"/>

            <Border Margin="0,0,0,18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDpcAvailable}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{StaticResource Color.SurfaceSolid}" BorderBrush="{StaticResource Color.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="% DPC Time" Foreground="{StaticResource Color.TextMuted}" FontFamily="{StaticResource Font.Mono}" FontSize="10"/>
                                <TextBlock Foreground="{StaticResource Color.Text}" FontSize="15" Text="{Binding DpcPercent, StringFormat={}{0:0.00}%}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="% Interrupt Time" Foreground="{StaticResource Color.TextMuted}" FontFamily="{StaticResource Font.Mono}" FontSize="10"/>
                                <TextBlock Foreground="{StaticResource Color.Text}" FontSize="15" Text="{Binding InterruptPercent, StringFormat={}{0:0.00}%}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Foreground="{StaticResource Color.TextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagDpcNote}"/>
                    </StackPanel>
                </Border>
            </Border>

            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}" Margin="0,0,0,10"
                       Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagGpuHeader}"/>

            <ItemsControl ItemsSource="{Binding GpuDrivers}" Margin="0,0,0,18">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Color.SurfaceSolid}" BorderBrush="{StaticResource Color.Border}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="13"/>
                                    <TextBlock Text="{Binding VersionLabel}" Foreground="{StaticResource Color.TextMuted}"
                                               FontFamily="{StaticResource Font.Mono}" FontSize="10.5"/>
                                </StackPanel>
                                <Button Grid.Column="1" Padding="12,6" Cursor="Hand" BorderThickness="1" VerticalAlignment="Center"
                                        BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                                        Command="{Binding OpenDriverPageCommand}"
                                        Content="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagGpuOpenBtn}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}" Margin="0,4,0,10"
                       Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagDevicesHeader}"/>

            <TextBlock Margin="0,0,0,10" Foreground="{StaticResource Color.TextMuted}" FontSize="12"
                       Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagDevicesEmpty}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Devices}" Margin="0,0,0,18">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Color.SurfaceSolid}"
                                BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="13"/>
                                    <TextBlock Text="{Binding ErrorLabel}" Foreground="{StaticResource Color.TextMuted}"
                                               FontFamily="{StaticResource Font.Mono}" FontSize="10.5"/>
                                </StackPanel>

                                <Button Grid.Column="1" Padding="12,6" Cursor="Hand" BorderThickness="1" VerticalAlignment="Center"
                                        BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                                        Command="{Binding SearchCommand}"
                                        Content="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagSearchBtn}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}" Margin="0,0,0,10"
                       Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagQuickLinksHeader}"/>

            <WrapPanel>
                <Button Style="{StaticResource QuickLinkButtonStyle}" Command="{Binding OpenDeviceManagerCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <Canvas Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Rectangle Canvas.Left="1" Canvas.Top="2" Width="18" Height="14" RadiusX="2" RadiusY="2"
                                       Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4"/>
                            <Line X1="7" Y1="19.5" X2="15" Y2="19.5" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="11" Y1="16" X2="11" Y2="19.5" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource Color.Text}"
                                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagDeviceManagerBtn}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickLinkButtonStyle}" Command="{Binding OpenSystemRestoreCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <Canvas Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Path Data="M10,2 A8,8 0 1 0 18,10" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4" Fill="Transparent"/>
                            <Path Data="M10,2 L10,7 L14,7" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource Color.Text}"
                                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagSystemRestoreBtn}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickLinkButtonStyle}" Command="{Binding OpenControlPanelCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <Canvas Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Ellipse Canvas.Left="7.5" Canvas.Top="7.5" Width="5" Height="5" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4"/>
                            <Path Data="M16,10 A6,6 0 0 0 15.75,8.3 L17.1,7.2 15.75,4.9 14.1,5.5 A6,6 0 0 0 12.6,4.6 L12.2,2.8 h-2.4 l-.4,1.8 A6,6 0 0 0 7.9,5.5 L6.25,4.9 4.9,7.2 6.25,8.3 A6,6 0 0 0 6.25,11.7 L4.9,12.8 6.25,15.1 7.9,14.5 A6,6 0 0 0 9.4,15.4 L9.8,17.2 h2.4 l.4,-1.8 A6,6 0 0 0 14.1,14.5 l1.65,.6 1.35,-2.3 -1.35,-1.1 A6,6 0 0 0 16,10 Z"
                                  Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.2" Fill="Transparent" StrokeLineJoin="Round"/>
                        </Canvas>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource Color.Text}"
                                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagControlPanelBtn}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickLinkButtonStyle}" Command="{Binding OpenSystemPropertiesCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <Canvas Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Rectangle Canvas.Left="2" Canvas.Top="3" Width="16" Height="11" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4"/>
                            <Line X1="7" Y1="17.5" X2="13" Y2="17.5" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                            <Line X1="10" Y1="14" X2="10" Y2="17.5" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4"/>
                            <Line X1="6" Y1="8" X2="14" Y2="8" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.2"/>
                        </Canvas>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource Color.Text}"
                                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagSystemPropertiesBtn}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickLinkButtonStyle}" Command="{Binding OpenProgramsFeaturesCommand}">
                    <StackPanel HorizontalAlignment="Center">
                        <Canvas Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Rectangle Canvas.Left="2.5" Canvas.Top="4" Width="15" Height="13" RadiusX="1.2" RadiusY="1.2"
                                       Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4"/>
                            <Line X1="2.5" Y1="8" X2="17.5" Y2="8" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4"/>
                            <Line X1="6.5" Y1="4" X2="6.5" Y2="2.3" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                            <Line X1="13.5" Y1="4" X2="13.5" Y2="2.3" Stroke="{StaticResource Color.TextMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                        </Canvas>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource Color.Text}"
                                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=DiagProgramsFeaturesBtn}"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
