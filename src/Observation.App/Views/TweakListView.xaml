<UserControl x:Class="Observation.App.Views.TweakListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Лёгкое появление вкладки при переключении (fade+slide, 220мс) — см. .panelIn в макете. -->
    <UserControl.RenderTransform>
        <TranslateTransform Y="6"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="6" To="0" Duration="0:0:0.22"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <!--
        Генератор списка твиков: группы из TweakDefinition.Group, строки из
        TweakDefinition внутри группы — общий шаблон для всех вкладок с твиками.
        Заголовки групп и чип severity стилизованы под макет (IBM Plex Mono,
        цветная пилюля по важности); фоновая иллюстрация/зерно/декоративные SVG
        из ui-preview.html сюда сознательно не перенесены — не несут функции.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="0,0,0,10" Foreground="{StaticResource Color.TextMuted}"
                       Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=TweakListEmpty}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding GroupName}" Foreground="{StaticResource Color.TextMuted}"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Color.SurfaceSolid}"
                                                BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Color.TextMuted}"
                                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                                        BorderThickness="1" CornerRadius="100" Padding="8,3"
                                                        Background="{Binding Definition.Severity, Converter={StaticResource SeverityToSoftBrush}}"
                                                        BorderBrush="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                 Fill="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                        <TextBlock Text="{Binding SeverityLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                                                   Foreground="{Binding Definition.Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                    </StackPanel>
                                                </Border>

                                                <ToggleButton Grid.Column="2" IsChecked="{Binding IsOn}"
                                                              Style="{StaticResource SwitchToggleStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
