<UserControl x:Class="Observation.App.Views.TweakListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Генератор списка твиков: группы из TweakDefinition.Group, строки из
        TweakDefinition внутри группы — общий шаблон для всех вкладок с твиками,
        без пиксель-точной стилизации карточек/чипов из ui-preview.html (это
        отдельный, более поздний проход).
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Margin="0,0,0,10" Foreground="{StaticResource Color.TextMuted}"
                       Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=TweakListEmpty}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding GroupName}" Foreground="{StaticResource Color.TextMuted}"
                                       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Color.SurfaceSolid}"
                                                BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Color.Text}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Color.TextMuted}"
                                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding SeverityLabel}"
                                                           Foreground="{StaticResource Color.TextMuted}"
                                                           FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <ToggleButton Grid.Column="2" IsChecked="{Binding IsOn}"
                                                              Style="{StaticResource SwitchToggleStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
