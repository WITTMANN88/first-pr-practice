<UserControl x:Class="Observation.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Реальная очередь применения (TweakLibrary.PendingChanges по всем вкладкам) и кнопка
        «Применить» через BatchRunner, плюс карточка характеристик ПК (только чтение),
        пресеты (только выставляют тумблеры) и панель последних записей журнала.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
        <TextBlock Foreground="{StaticResource Color.TextMuted}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,18"
                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=HomePlaceholder}"/>

        <!-- Характеристики ПК — только чтение (Get-CimInstance Win32_OperatingSystem/Win32_Processor/... из плана). -->
        <Border Background="{StaticResource Color.SurfaceSolid}" BorderBrush="{StaticResource Color.Border}"
                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}"
                           Margin="0,0,0,8"
                           Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=HomeSpecsLabel}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource Color.Text}" Margin="0,0,0,3">
                    <Run FontWeight="Bold" Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=HomeSpecsOs}"/>
                    <Run Text=": "/><Run Text="{Binding PcSpecs.OsCaption, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Color.Text}" Margin="0,0,0,3">
                    <Run FontWeight="Bold" Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=HomeSpecsCpu}"/>
                    <Run Text=": "/><Run Text="{Binding PcSpecs.CpuName, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Color.Text}" Margin="0,0,0,3">
                    <Run FontWeight="Bold" Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=HomeSpecsGpu}"/>
                    <Run Text=": "/><Run Text="{Binding PcSpecs.GpuName, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Color.Text}" Margin="0,0,0,3">
                    <Run FontWeight="Bold" Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=HomeSpecsRam}"/>
                    <Run Text=": "/><Run Text="{Binding PcSpecs.RamTotal, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{StaticResource Color.Text}">
                    <Run FontWeight="Bold" Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=HomeSpecsDisk}"/>
                    <Run Text=": "/><Run Text="{Binding PcSpecs.DiskInfo, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Пресеты — только выставляют тумблеры по вкладкам, не применяют (см. план). -->
        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}" Margin="0,0,0,8"
                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=HomePresetsLabel}"/>
        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,18">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Padding="12,6" Margin="0,0,8,8" Cursor="Hand" BorderThickness="1"
                            BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                            ToolTip="{Binding Description}" Content="{Binding Name}"
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Id}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,0,0,8">
            <Run Foreground="{StaticResource Color.TextMuted}"
                 Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Mode=OneWay, Converter={StaticResource LocalizedText}, ConverterParameter=HomePendingLabel}"/>
            <Run Foreground="{StaticResource Color.Text}" FontWeight="Bold" Text="{Binding PendingCount, Mode=OneWay}"/>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding PendingChanges}" Margin="0,0,0,14">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Foreground="{StaticResource Color.TextMuted}" FontSize="11" Margin="0,0,0,3">
                        <Run Text="{Binding Name, Mode=OneWay}"/>
                        <Run Text=" → "/>
                        <Run Text="{Binding IsOnLabel, Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button HorizontalAlignment="Left" Padding="16,8" Cursor="Hand" BorderThickness="0"
                Background="{StaticResource Color.Accent}" Foreground="White"
                Command="{Binding ApplyCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Content"
                            Value="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=HomeApplyBtn}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsApplying}" Value="True">
                            <Setter Property="Content"
                                    Value="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=HomeApplyingBtn}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <TextBlock Text="{Binding ResultMessage}" Margin="0,12,0,24"
                   Visibility="{Binding ResultMessage, Converter={StaticResource NullOrEmptyToVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Color.Ok}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultHasFailures}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Color.Danger}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!--
            Активные твики из журнала — «Проверить состояние» (мех. надёжности №1) и точечный
            откат конкретного твика к состоянию "до" применения (через журнал, не к offData —
            см. HomeTabViewModel.RevertTweakAsync).
        -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Foreground="{StaticResource Color.TextMuted}" VerticalAlignment="Center"
                       Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=HomeActiveTweaksLabel}"/>

            <Button Grid.Column="1" Padding="12,6" Cursor="Hand" BorderThickness="1"
                    BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                    Command="{Binding VerifyCommand}"
                    Content="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=HomeVerifyBtn}"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding ActiveTweaks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Color.SurfaceSolid}"
                            BorderBrush="{StaticResource Color.Border}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Color.Text}"
                                       FontSize="13" VerticalAlignment="Center"/>

                            <Button Grid.Column="1" Padding="10,5" Cursor="Hand" BorderThickness="1"
                                    BorderBrush="{StaticResource Color.Border}" Background="Transparent" Foreground="{StaticResource Color.Text}"
                                    Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Definition.Id}"
                                    Content="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=HomeRevertBtn}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Панель журнала — последние записи из journal.jsonl, история отдельно от «активных твиков». -->
        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource Color.TextMuted}" Margin="0,18,0,8"
                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=HomeJournalLabel}"/>

        <TextBlock Foreground="{StaticResource Color.TextMuted}" FontSize="12" Margin="0,0,0,8"
                   Text="{Binding Source={StaticResource Localization}, Path=CurrentLanguage, Converter={StaticResource LocalizedText}, ConverterParameter=HomeJournalEmpty}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RecentJournalEntries.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding RecentJournalEntries}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                   Foreground="{StaticResource Color.TextMuted}" Margin="0,0,10,0" VerticalAlignment="Top"
                                   Text="{Binding Timestamp, StringFormat='{}{0:g}'}"/>

                        <TextBlock Grid.Column="1" FontSize="12">
                            <Run Text="{Binding TweakName, Mode=OneWay}" Foreground="{StaticResource Color.Text}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding Message, Mode=OneWay}" Foreground="{Binding Success, Converter={StaticResource BoolToStatusBrush}}"/>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
    </ScrollViewer>
</UserControl>
