<Application x:Class="Observation.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Observation.App.ViewModels"
             xmlns:views="clr-namespace:Observation.App.Views"
             xmlns:conv="clr-namespace:Observation.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Fonts.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility"/>
            <conv:SeverityToBrushConverter x:Key="SeverityToBrush"/>
            <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush"/>
            <conv:InverseBooleanConverter x:Key="InverseBool"/>

            <!--
                Localization/LocalizedText/LocalizedTextMulti регистрируются в App.xaml.cs
                (OnStartup) — им нужен доступ к готовому экземпляру ILocalizationService,
                который здесь, в разметке, взять негде.
            -->

            <!--
                Анимированный тумблер в собственном стиле, не системный чекбокс — явное
                требование плана («Сквозные требования к интерфейсу»). Едет по RenderTransform
                ползунка (свежий TranslateTransform на каждый экземпляр, не общий ресурс) —
                анимировать напрямую StaticResource-кисть нельзя, WPF замораживает такие кисти
                для производительности, и Storyboard на заморженном объекте падает в рантайме.
                Поэтому цвет фона переключается мгновенно (Setter), а не анимируется.
            -->
            <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="21"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Track" CornerRadius="10.5" Background="{StaticResource Color.BorderStrong}">
                                <Ellipse x:Name="Thumb" Width="17" Height="17" Fill="{StaticResource Color.Text}"
                                         HorizontalAlignment="Left" Margin="2,0,0,0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbSlide" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource Color.Accent}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbSlide" Storyboard.TargetProperty="X"
                                                                 To="17" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ThumbSlide" Storyboard.TargetProperty="X"
                                                                 To="0" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Кнопка «?» с попапом-подсказкой у твика (ToggleButton, не Button) — открытие/
                закрытие через саму привязку IsChecked, никакого code-behind. Popup рядом
                биндится Mode=TwoWay к тому же IsChecked: StaysOpen="False" сам сбрасывает
                Popup.IsOpen при клике снаружи, и это должно долетать обратно до кнопки.
            -->
            <Style x:Key="InfoToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{StaticResource Color.TextMuted}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Circle" CornerRadius="9" BorderThickness="1"
                                    BorderBrush="{StaticResource Color.BorderStrong}" Background="Transparent">
                                <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Color.Accent}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Color.Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Circle" Property="Background" Value="{StaticResource Color.AccentSoft}"/>
                                    <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Color.Accent}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Color.Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Всплывающая карточка подсказки — общий вид для всех вкладок с твиками
                (TweakListView/DebloatView/CleanView/DiagView/AppsView).
            -->
            <Style x:Key="InfoPopupBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Color.SurfaceSolid}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Color.BorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="MaxWidth" Value="280"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Кнопка основного действия (сейчас — «Применить» на «Главной») — обязательно со
                своим ControlTemplate: у стандартного шаблона Button на классической теме WPF
                Background не красит заливку лицевой стороны кнопки (только рамку/оверлеи
                hover/pressed), поэтому обычная кнопка с Background=Color.Accent без Template
                визуально выглядит пустым белым прямоугольником с невидимым текстом — именно
                так и было найдено вживую на реальной машине (см. историю коммитов).
            -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource Color.Accent}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <!-- Плавный переход на наведении вместо мгновенной смены цвета: анимировать напрямую
                                         замороженный общий StaticResource-брэш нельзя (см. SwitchToggleStyle выше) —
                                         вместо этого сверху лежит отдельный слой, у которого анимируется Opacity, а не цвет. -->
                                    <Border x:Name="HoverOverlay" Background="{StaticResource Color.AccentStrong}" CornerRadius="8" Opacity="0"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Color.AccentStrong}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Кнопка по умолчанию для всех обычных Button без явного Style (ghost-кнопки
                со сплошной прозрачной заливкой — «Сканировать», «Выполнить», карточки твиков
                и т.п. по всему приложению). Без этого стиля они рендерились через системный
                ControlTemplate классической темы: сама заливка не показывалась (Background
                игнорируется, тот же корень, что и у бага невидимой кнопки «Применить» —
                см. PrimaryButtonStyle выше), но наведение мышью всё равно рисовало системный
                серо-голубой хайлайт вместо акцентного — визуально не соответствовало макету.
                Локальные Background/BorderBrush/Foreground на каждой конкретной кнопке (обычно
                Transparent/Color.Border/Color.Text) по-прежнему применяются через TemplateBinding —
                этот стиль только даёт правильный шаблон и акцентное наведение, не меняет цвета.
            -->
            <Style TargetType="Button">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <Grid>
                                    <!-- Тот же приём, что в PrimaryButtonStyle: плавно анимируется Opacity отдельного
                                         слоя-подсветки, а не цвет общего замороженного брэша. -->
                                    <Border x:Name="HoverOverlay" Background="{StaticResource Color.AccentSoft}" CornerRadius="7" Opacity="0"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Color.Accent}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Color.Accent}"/>
                                    <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Переключатель языка в титлбаре (RU/EN) — раньше был голыми системными
                RadioButton (кружки), сильно отличался от пилюли-переключателя в макете
                (.langswitch). Теперь свой ControlTemplate: выбранный язык — акцентная
                заливка и белый текст, невыбранный — приглушённый текст, светлеет при наведении.
            -->
            <Style x:Key="LangToggleButtonStyle" TargetType="RadioButton">
                <Setter Property="Padding" Value="9,3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="Foreground" Value="{StaticResource Color.TextMuted}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="100">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Color.Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Color.Accent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Чекбокс по умолчанию (сейчас единственный в приложении — «понимаю риски» в
                ApplySummaryWindow) — без своего шаблона рисуется системным белым квадратом
                классической темы, тот же класс несоответствия тёмной теме, что был у Button/
                RadioButton выше. Квадрат 16×16 со скруглением, акцентная заливка + галочка
                при отметке, акцентная рамка при наведении/фокусе клавиатурой.
            -->
            <Style TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{StaticResource Color.BorderStrong}" Background="Transparent" VerticalAlignment="Top">
                                    <Path x:Name="Check" Margin="2" Data="M1,5.5 L4.5,9 L11,1.5" Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource Color.Accent}"/>
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Color.Accent}"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Color.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Color.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Тонкий скролл-бар в стиле приложения вместо системного (в макете скролл-контейнер
                не переполнялся достаточно, чтобы это увидеть — своей раскладки для скроллбара там
                нет; системный светло-серый классический скроллбар Windows сильно выбивался из
                тёмно-бордовой темы, найдено по скриншоту реальной машины). Только "бегунок" без
                стрелок вверх/вниз — минималистичный трек, подсвечивается акцентом при наведении/
                перетаскивании.
            -->
            <Style x:Key="ThinScrollBarThumbStyle" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Bg" Background="{StaticResource Color.BorderStrong}" CornerRadius="4" Margin="1,0"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Color.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource Color.AccentStrong}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThinScrollBarThumbStyle}" Width="6"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MinHeight" Value="8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Генератор вкладок из ViewModels/MainWindowViewModel.CreateTab — WPF сам выбирает
                 шаблон по типу CurrentTab через ContentControl в MainWindow.xaml. -->
            <DataTemplate DataType="{x:Type vm:HomeTabViewModel}">
                <views:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TweakListTabViewModel}">
                <views:TweakListView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DebloatTabViewModel}">
                <views:DebloatView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppsTabViewModel}">
                <views:AppsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScriptsTabViewModel}">
                <views:ScriptsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleanTabViewModel}">
                <views:CleanView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagTabViewModel}">
                <views:DiagView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
