<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Software logos as pure vector DrawingImages (no external files).
         Every drawing uses a 48x48 coordinate space; a transparent 48x48
         rectangle is drawn first so all images share identical bounds and
         scale uniformly inside an Image control.
         Simplified renditions for identification on the install cards.
         Resource key = "Logo." + SoftwareItem.Key.
         ============================================================ -->

    <!-- Shared transparent bounds (48x48). -->
    <RectangleGeometry x:Key="LogoBounds" Rect="0,0,48,48" />

    <!-- Google Chrome.
         Three segments built with the tangent construction: outer radius 22,
         inner radius 11 (cos 60 = 11/22), so each divider runs from the outer
         circle tangent to the inner circle. Red top, yellow lower-right, green
         lower-left; a white ring and blue centre sit on top. -->
    <DrawingImage x:Key="Logo.chrome">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource LogoBounds}" />
                <GeometryDrawing Brush="#FFEA4335"
                                 Geometry="M 43.053,13 A 22,22 0 0 0 4.947,13 L 14.474,29.5 A 11,11 0 0 1 24,13 Z" />
                <GeometryDrawing Brush="#FF34A853"
                                 Geometry="M 4.947,13 A 22,22 0 0 0 24,46 L 33.526,29.5 A 11,11 0 0 1 14.474,29.5 Z" />
                <GeometryDrawing Brush="#FFFBBC04"
                                 Geometry="M 24,46 A 22,22 0 0 0 43.053,13 L 24,13 A 11,11 0 0 1 33.526,29.5 Z" />
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="24,24" RadiusX="11" RadiusY="11" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FF1A73E8">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="24,24" RadiusX="8.6" RadiusY="8.6" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 7-Zip: black tile with a bold "7z" stroked in white. -->
    <DrawingImage x:Key="Logo.7zip">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource LogoBounds}" />
                <GeometryDrawing Brush="#FF0A0A0A">
                    <GeometryDrawing.Pen><Pen Brush="#FF3A3A3A" Thickness="1.5" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="3,3,42,42" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- "7" -->
                <GeometryDrawing Geometry="M 11,14 H 23 L 15.5,34">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="4" LineJoin="Miter" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- "z" -->
                <GeometryDrawing Geometry="M 26.5,21 H 37.5 L 26.5,34 H 37.5">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="3.5" LineJoin="Miter" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Discord: blurple rounded tile with the white "Clyde" silhouette,
         symmetric about x = 24; eyes are cut back in the tile colour. -->
    <DrawingImage x:Key="Logo.discord">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource LogoBounds}" />
                <GeometryDrawing Brush="#FF5865F2">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="2,2,44,44" RadiusX="11" RadiusY="11" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFFFF"
                                 Geometry="M 12.2,16.6 C 15.3,15 18.6,13.8 21.8,13.3 L 22.9,15.2
                                           C 23.6,15.1 24.4,15.1 25.1,15.2 L 26.2,13.3
                                           C 29.4,13.8 32.7,15 35.8,16.6 C 39.1,21.6 40.4,27.4 39.8,33.1
                                           C 37.3,35 34.6,36.3 31.4,37.2 L 29.7,34.6
                                           C 27.9,35.2 26,35.5 24,35.5 C 22,35.5 20.1,35.2 18.3,34.6
                                           L 16.6,37.2 C 13.4,36.3 10.7,35 8.2,33.1
                                           C 7.6,27.4 8.9,21.6 12.2,16.6 Z" />
                <GeometryDrawing Brush="#FF5865F2">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="18.9,26.4" RadiusX="2.7" RadiusY="3.0" />
                            <EllipseGeometry Center="29.1,26.4" RadiusX="2.7" RadiusY="3.0" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Steam: dark-blue gradient disc with the white valve mechanism — a large
         ring (with hub), a small ring, and the connecting arm. Rings use EvenOdd
         so the holes are real cut-outs and show the gradient beneath. -->
    <DrawingImage x:Key="Logo.steam">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource LogoBounds}" />
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#FF10213A" Offset="0" />
                            <GradientStop Color="#FF1A5C92" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="24,24" RadiusX="22" RadiusY="22" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- large ring + hub -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup FillRule="EvenOdd">
                            <EllipseGeometry Center="30.5,18" RadiusX="7.2" RadiusY="7.2" />
                            <EllipseGeometry Center="30.5,18" RadiusX="5.0" RadiusY="5.0" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="30.5,18" RadiusX="3.3" RadiusY="3.3" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- arm: from the small ring's outer edge to the large ring's outer edge -->
                <GeometryDrawing Geometry="M 20.4,27.9 L 25.6,22.8">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="3.2" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- small ring -->
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup FillRule="EvenOdd">
                            <EllipseGeometry Center="17.5,30.8" RadiusX="4.4" RadiusY="4.4" />
                            <EllipseGeometry Center="17.5,30.8" RadiusX="2.5" RadiusY="2.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ISLC (standby-list / memory cleaner): white RAM module on the accent tile. -->
    <DrawingImage x:Key="Logo.islc">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource LogoBounds}" />
                <GeometryDrawing Brush="#FF9B1B1B">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="3,3,42,42" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="2" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="8,15,32,15" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="11.5,18.5,6,7" />
                            <RectangleGeometry Rect="21,18.5,6,7" />
                            <RectangleGeometry Rect="30.5,18.5,6,7" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M11,30 V34 M14,30 V34 M17,30 V34 M20,30 V34 M23,30 V34 M28,30 V34 M31,30 V34 M34,30 V34 M37,30 V34">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="1.6" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- MakuTweaker (system tweaker): white open-jaw wrench on the accent tile.
         Jaw = 310-degree arc (r 5.2, centre 28.2,19.8) leaving the opening at
         the upper right; handle leaves the ring at 225 degrees. -->
    <DrawingImage x:Key="Logo.maku">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource LogoBounds}" />
                <GeometryDrawing Brush="#FF9B1B1B">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="3,3,42,42" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 29.98,14.91 A 5.2,5.2 0 1 0 33.09,18.02">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="4" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 24.52,23.48 L 14.5,33.5">
                    <GeometryDrawing.Pen><Pen Brush="#FFFFFFFF" Thickness="4.5" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
