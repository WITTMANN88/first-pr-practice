<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Stakeout.Converters">

    <!-- Value converters -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:StringToVisibilityConverter x:Key="StringToVis" />
    <conv:TempHotToBrushConverter x:Key="TempHotToBrush" />
    <conv:NotificationKindToBrushConverter x:Key="NotificationKindToBrush" />
    <conv:UwpCategoryToBrushConverter x:Key="UwpCategoryToBrush" />
    <conv:ResourceKeyToImageConverter x:Key="ResourceKeyToImage" />
    <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
    <conv:IconPathToImageConverter x:Key="IconPathToImage" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />

    <!-- ============================================================
         STAKEOUT theme.
         Palette: pure black background, sharp 0px corners, rich dark-red
         accent. Text is white at 87% (primary) and 60% (secondary).
         Heading font is a Lovecraftian serif (Cinzel; Cyrillic in Cormorant SC)
         with graceful fallback; body text uses the system grotesque for readability.
         ============================================================ -->

    <!-- Colors -->
    <Color x:Key="BgColor">#FF000000</Color>
    <Color x:Key="SurfaceColor">#FF0D0D0D</Color>
    <Color x:Key="HoverColor">#FF1A1A1A</Color>
    <Color x:Key="AccentColor">#FF9B1B1B</Color>
    <Color x:Key="AccentBrightColor">#FFC41E1E</Color>
    <Color x:Key="DividerColor">#FF2A2A2A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <!-- 0xDE ≈ 87%, 0x99 ≈ 60%, 0x66 ≈ 40% -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#DEFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#66FFFFFF" />
    <!-- Chart ink on the card surface (#0D0D0D): the data line is white 60%
         (7.3:1); the reference line is white 40% (3.8:1, above the 3:1 needed
         for non-text graphics). Chart labels are text, so they use
         TextSecondaryBrush (4.5:1 minimum), never the reference-line ink. -->
    <SolidColorBrush x:Key="ChartLineBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="ChartReferenceBrush" Color="#66FFFFFF" />

    <!-- Heading fonts embedded as <Resource> (see STAKEOUT.csproj and
         prepare-assets.ps1). Verified against the WPF 8 runtime: the family list
         tokenizer treats ",," as an escaped comma, so this string yields an
         unresolvable "pack://application:," token (skipped) plus
         "/Assets/Fonts/#Cinzel", which is resolved against this dictionary's
         pack BaseUri to the embedded font; "/Assets/Fonts/#Cormorant SC" is
         resolved the same way.
         WPF falls back through the list per character: Cinzel has no Cyrillic
         (0 of the 66 А-я/Ёё glyphs), so Russian text is set in Cormorant SC
         (all 66, Regular and Bold), a classical small-caps serif of the same
         inscriptional kind. Constantia / Georgia are the fallbacks if the
         fonts were not embedded. -->
    <FontFamily x:Key="HeadingFont">pack://application:,,,/Assets/Fonts/#Cinzel, /Assets/Fonts/#Cormorant SC, Constantia, Georgia</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI, Arial, sans-serif</FontFamily>

    <!-- Typography -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Card: dark surface, sharp corners, drop shadow for depth, and a
         subtle 2% scale-up on hover. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6" Color="#FF000000" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.02" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.02" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             To="1.0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             To="1.0" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar navigation button. Active state is bound via Tag='active'
         which reveals the vertical dark-red marker on the left edge. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Marker" Width="3" HorizontalAlignment="Left"
                                Background="{StaticResource AccentBrush}" Opacity="0" />
                        <Border x:Name="Hover" Background="Transparent" Margin="3,0,0,0">
                            <ContentPresenter VerticalAlignment="Center" Margin="18,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Marker" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="Hover" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar action button (opens something, is not a page): same metrics
         and hover as NavButton, without the active marker. Content starts at
         21px so its icon lines up with the nav icons (3px marker + 18px). -->
    <Style x:Key="SideActionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" Margin="21,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary button: outlined, transparent, sharp corners. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="1"
                            BorderBrush="{StaticResource DividerBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action button (sharp corners, dark-red). -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Apply" button that pulses with a dark-red glow while a restart-requiring
         tweak is pending (spec: "плавно пульсирует свечением"). Pulse is toggled
         by setting Tag to 'pulse'; the glow is an accent-coloured shadow whose
         opacity breathes, so the button itself stays fully readable. -->
    <Style x:Key="PulseButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource AccentBrightColor}" ShadowDepth="0" BlurRadius="22" Opacity="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="pulse">
                <Trigger.EnterActions>
                    <BeginStoryboard Name="PulseSb">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                             From="0.15" To="0.95" Duration="0:0:0.9">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="PulseSb" />
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Custom spring toggle switch (a restyled ToggleButton). The thumb moves
         with a damped spring (ElasticEase: one overshoot and settle) in 250 ms. -->
    <Style x:Key="StakeoutToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="12"
                                Background="{StaticResource HoverBrush}"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" />
                        <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                HorizontalAlignment="Left" Margin="3,0,0,0"
                                Background="{StaticResource TextSecondaryBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbShift" X="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Thumb" Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="22" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caption / window control button (flat, hover highlight). -->
    <Style x:Key="CaptionBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim, self-hiding scrollbar (macOS / Win11 style). Implicit: applies to
         every ScrollBar in the app. At rest it is a faint 3 px line; hovering the
         scrollbar fades it in and widens the thumb to 6 px. Vertical and
         horizontal need separate templates: a vertical track is
         direction-reversed and pages up/down, a horizontal one pages left/right,
         and each is thin along a different axis. -->
    <Style x:Key="SlimThumbVertical" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Width="3" HorizontalAlignment="Right" Margin="0,0,1,0"
                            CornerRadius="3" Background="#4DFFFFFF" />
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter TargetName="Bd" Property="Width" Value="6" />
                            <Setter TargetName="Bd" Property="Background" Value="#80FFFFFF" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Width" Value="6" />
                            <Setter TargetName="Bd" Property="Background" Value="#A6FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SlimThumbHorizontal" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,1"
                            CornerRadius="3" Background="#4DFFFFFF" />
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter TargetName="Bd" Property="Height" Value="6" />
                            <Setter TargetName="Bd" Property="Background" Value="#80FFFFFF" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Height" Value="6" />
                            <Setter TargetName="Bd" Property="Background" Value="#A6FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Invisible paging areas either side of the thumb; not tab stops. -->
    <Style x:Key="SlimPager" TargetType="RepeatButton">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <ControlTemplate x:Key="SlimVerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb><Thumb Style="{StaticResource SlimThumbVertical}" /></Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SlimPager}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SlimPager}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="SlimHorizontalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.Thumb><Thumb Style="{StaticResource SlimThumbHorizontal}" /></Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SlimPager}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SlimPager}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Template" Value="{StaticResource SlimVerticalScrollBar}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template" Value="{StaticResource SlimHorizontalScrollBar}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dark tooltip (implicit). The system default is a light box, on which the
         app's light text would be unreadable. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#FF141414" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="10,7" MaxWidth="360">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark square checkbox (implicit): accent fill and a white tick when checked. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" VerticalAlignment="Center"
                                Background="{StaticResource HoverBrush}"
                                BorderBrush="{StaticResource TextMutedBrush}" BorderThickness="1">
                            <Path x:Name="Tick" Data="M2.5,7.5 L6,11 L12.5,3.5" Stroke="#FFFFFFFF"
                                  StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Error shake (spec: failures shake the element). For any element whose
         RenderTransform is a TranslateTransform; begun from a DataTrigger on the
         view model's Failed flag. Same curve as the error toast. -->
    <Storyboard x:Key="ShakeStoryboard">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.X">
            <LinearDoubleKeyFrame Value="-8" KeyTime="0:0:0.04" />
            <LinearDoubleKeyFrame Value="8"  KeyTime="0:0:0.12" />
            <LinearDoubleKeyFrame Value="-6" KeyTime="0:0:0.20" />
            <LinearDoubleKeyFrame Value="6"  KeyTime="0:0:0.28" />
            <LinearDoubleKeyFrame Value="0"  KeyTime="0:0:0.36" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- Rounded progress bar with a moving highlight. -->
    <Style x:Key="RoundedProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="5" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    CornerRadius="5" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
