<UserControl x:Class="Stakeout.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Stakeout.Localization;assembly=STAKEOUT.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:design="clr-namespace:Stakeout.Design"
             mc:Ignorable="d"
             d:DataContext="{x:Static design:DesignData.Apps}"
             d:DesignWidth="880" d:DesignHeight="640" d:Background="#FF000000"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform><TranslateTransform x:Name="Slide" Y="15" /></UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y"
                                     From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Apps_Title}" Style="{StaticResource H1}" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="{x:Static loc:Strings.Apps_RefreshList}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadCommand}" />
            <Button Content="{x:Static loc:Strings.Apps_SelectJunk}" Style="{StaticResource PrimaryButton}"
                    Margin="10,0,0,0" Command="{Binding SelectJunkCommand}" />
            <Button Content="{x:Static loc:Strings.Apps_RemoveSelected}" Style="{StaticResource PrimaryButton}"
                    Margin="10,0,0,0" Command="{Binding RemoveSelectedCommand}" />
        </StackPanel>

        <!-- loading skeleton -->
        <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.Apps_Loading}" Style="{StaticResource Caption}"
                   VerticalAlignment="Top"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Background comes from the style: a local value would
                             override the hover trigger. -->
                        <Border Padding="8,6" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><TranslateTransform X="0" /></Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding CanRemove}" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding DisplayName}" />

                                <!-- icon (UWP logo or the program's DisplayIcon, loaded in the
                                     background), with a letter-tile fallback -->
                                <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center">
                                    <Border Background="{StaticResource HoverBrush}"
                                            Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="{Binding Initial}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding Icon}" Stretch="Uniform"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>

                                <!-- name (tooltip: publisher · version, or the package name);
                                     while a desktop uninstaller window is open, a status line -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Body}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                    <TextBlock Text="{x:Static loc:Strings.Apps_Uninstalling}" Style="{StaticResource Caption}"
                                               Foreground="{StaticResource AccentBrightBrush}"
                                               Visibility="{Binding IsUninstalling, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!-- kind badge: how the app is installed and removed -->
                                <Grid Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Border Background="{Binding Kind, Converter={StaticResource AppKindToBrush}}" Opacity="0.16" />
                                    <Border BorderThickness="1" Padding="7,1"
                                            BorderBrush="{Binding Kind, Converter={StaticResource AppKindToBrush}}">
                                        <TextBlock Text="{Binding KindText}" FontSize="11"
                                                   Foreground="{Binding Kind, Converter={StaticResource AppKindToBrush}}" />
                                    </Border>
                                </Grid>

                                <!-- category badge (UwpCatalog), UWP only: tinted fill, border and text in the category colour -->
                                <Grid Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="0,0,12,0" ToolTip="{Binding CategoryText}"
                                      Visibility="{Binding IsDesktop, Converter={StaticResource InverseBoolToVis}}">
                                    <Border Background="{Binding Category, Converter={StaticResource AppCategoryToBrush}}"
                                            Opacity="0.16" />
                                    <Border BorderThickness="1" Padding="7,1"
                                            BorderBrush="{Binding Category, Converter={StaticResource AppCategoryToBrush}}">
                                        <TextBlock Text="{Binding CategoryText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Category, Converter={StaticResource AppCategoryToBrush}}" />
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{x:Static loc:Strings.Apps_Protected}" Style="{StaticResource Caption}"
                                           Foreground="{StaticResource AccentBrightBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding IsCritical, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                        </Trigger>
                                        <!-- Removal failed: shake the row. -->
                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Storyboard="{StaticResource ShakeStoryboard}" />
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                        <!-- SlideOut + FadeOut on removal. No TargetName:
                                             the animations target the styled Border itself. -->
                                        <DataTrigger Binding="{Binding IsRemoving}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                                         To="400" Duration="0:0:0.32">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.32" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding FreedText}" Style="{StaticResource H2}"
                   Margin="0,12,0,0" HorizontalAlignment="Right" />
    </Grid>
</UserControl>
