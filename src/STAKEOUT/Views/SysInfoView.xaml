<UserControl x:Class="Stakeout.Views.SysInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="СИСТЕМА" Style="{StaticResource H1}" />
            <Button Content="Обновить" Style="{StaticResource PrimaryButton}"
                    Margin="20,0,0,0" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- Shimmer skeleton shown while WMI/LHM queries run. -->
        <ItemsControl Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <Border Style="{StaticResource Card}" Width="260" Height="110" Margin="0,0,16,16">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.35" To="0.8" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <Border Style="{StaticResource Card}" Width="260" Height="110" Margin="0,0,16,16" Opacity="0.5" />
            <Border Style="{StaticResource Card}" Width="260" Height="110" Margin="0,0,16,16" Opacity="0.5" />
            <Border Style="{StaticResource Card}" Width="260" Height="110" Margin="0,0,16,16" Opacity="0.5" />
        </ItemsControl>

        <!-- Real content. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <WrapPanel>
                <!-- CPU card with temperature bar -->
                <Border Style="{StaticResource Card}" Width="360" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="ПРОЦЕССОР" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource H2}"
                                   TextWrapping="Wrap" Margin="0,4,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Style="{StaticResource RoundedProgress}"
                                         Minimum="0" Maximum="100" Value="{Binding CpuTempValue, Mode=OneWay}"
                                         Foreground="{Binding TempIsHot, Converter={StaticResource TempHotToBrush}}"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding CpuTempText}"
                                       Style="{StaticResource Body}" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Motherboard -->
                <Border Style="{StaticResource Card}" Width="260" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="МАТЕРИНСКАЯ ПЛАТА" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Motherboard}" Style="{StaticResource H2}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- GPUs (integrated + discrete as separate rows) -->
                <Border Style="{StaticResource Card}" Width="360" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="ВИДЕОКАРТЫ" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Gpus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Style="{StaticResource Body}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                                   Style="{StaticResource Caption}" Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Style="{StaticResource Card}" Width="220" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding RamSummary}" Style="{StaticResource H2}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Disks -->
                <Border Style="{StaticResource Card}" Width="220" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="НАКОПИТЕЛИ" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding DiskSummary}" Style="{StaticResource H2}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Windows build -->
                <Border Style="{StaticResource Card}" Width="360" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="WINDOWS" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding WindowsVersion}" Style="{StaticResource H2}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
