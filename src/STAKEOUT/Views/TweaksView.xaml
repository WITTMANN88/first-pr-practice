<UserControl x:Class="Stakeout.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="Slide" Y="15" />
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y"
                                     From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ТВИКИ" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Content="Перезапустить проводник"
                    Command="{Binding RestartExplorerCommand}"
                    Visibility="{Binding PendingExplorerRestart, Converter={StaticResource BoolToVis}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PulseButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PendingExplorerRestart}" Value="True">
                                <Setter Property="Tag" Value="pulse" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Header}" Style="{StaticResource H2}"
                                       Foreground="{StaticResource AccentBrightBrush}" Margin="0,0,0,6" />
                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8" MaxWidth="720" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Custom spring toggle -->
                                            <ToggleButton Grid.Column="0" Style="{StaticResource StakeoutToggle}"
                                                          IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                          VerticalAlignment="Top" Margin="0,2,0,0" />

                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}"
                                                               FontWeight="SemiBold" />
                                                    <!-- [?] help with delayed tooltip -->
                                                    <Border Width="16" Height="16" Margin="8,0,0,0" CornerRadius="8"
                                                            Background="{StaticResource HoverBrush}"
                                                            ToolTipService.InitialShowDelay="300"
                                                            ToolTipService.ShowDuration="8000">
                                                        <TextBlock Text="?" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Border.ToolTip>
                                                            <ToolTip MaxWidth="320">
                                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                    </Border>
                                                    <!-- restart / destructive badges -->
                                                    <TextBlock Text="перезагрузка" Style="{StaticResource Caption}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource AccentBrightBrush}"
                                                               Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- busy spinner dot -->
                                            <TextBlock Grid.Column="2" Text="…" Style="{StaticResource Body}"
                                                       Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
