<UserControl x:Class="Stakeout.Views.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Stakeout.Localization;assembly=STAKEOUT.Core"
             xmlns:c="clr-namespace:Stakeout.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:design="clr-namespace:Stakeout.Design"
             mc:Ignorable="d"
             d:DataContext="{x:Static design:DesignData.Logs}"
             d:DesignWidth="900" d:DesignHeight="600">
    <!-- Content of the in-app log modal. The overlay around it (backdrop,
         open/close animation, shadow, focus trap) lives in MainWindow; the
         DataContext is LogViewerViewModel, inherited from the overlay. -->
    <Border Background="#FF0D0D0D" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- accent rule -->
            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" />

            <!-- header -->
            <Grid Grid.Row="1" Margin="22,16,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Strings.Logs_Title}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LogPath}" Style="{StaticResource Caption}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="36" Height="36" VerticalAlignment="Top"
                        Style="{StaticResource CaptionBtn}" Command="{Binding CloseCommand}"
                        ToolTip="{x:Static loc:Strings.Logs_CloseTooltip}" />
            </Grid>

            <!-- body -->
            <Border Grid.Row="2" Margin="22,0" Background="#FF080808"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="12,8,4,8">
                <Grid>
                    <!-- loading: skeleton lines with running highlight -->
                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <c:SkeletonBlock Height="11" Width="540" HorizontalAlignment="Left" Margin="0,4" />
                        <c:SkeletonBlock Height="11" Width="420" HorizontalAlignment="Left" Margin="0,4" />
                        <c:SkeletonBlock Height="11" Width="600" HorizontalAlignment="Left" Margin="0,4" />
                        <c:SkeletonBlock Height="11" Width="360" HorizontalAlignment="Left" Margin="0,4" />
                        <c:SkeletonBlock Height="11" Width="500" HorizontalAlignment="Left" Margin="0,4" />
                        <c:SkeletonBlock Height="11" Width="280" HorizontalAlignment="Left" Margin="0,4" />
                    </StackPanel>

                    <!-- empty state -->
                    <TextBlock Text="{x:Static loc:Strings.Logs_Empty}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                    <!-- entries: virtualized, recycled rows inside a ScrollViewer.
                         Lines wrap, so no horizontal scrolling is needed. -->
                    <ItemsControl ItemsSource="{Binding Entries}"
                                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- [time]  action  STATUS  detail — status coloured by level.
                                 LogEntry is immutable: OneTime (re-evaluated when a
                                 recycled row gets a new item, never tracked). -->
                                <TextBlock FontFamily="Consolas, Courier New" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,1,8,1"
                                           Foreground="{StaticResource TextSecondaryBrush}"><Run Text="{Binding Time, Mode=OneTime}" Foreground="{StaticResource TextMutedBrush}" /><Run Text="  " /><Run Text="{Binding Action, Mode=OneTime}" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="  " /><Run Text="{Binding Status, Mode=OneTime}" FontWeight="SemiBold" Foreground="{Binding Level, Mode=OneTime, Converter={StaticResource LogLevelToBrush}}" /><Run Text="  " /><Run Text="{Binding Detail, Mode=OneTime}" /></TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,14,22,18">
                <Button Content="{x:Static loc:Strings.Common_Refresh}" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshCommand}" />
                <Button Content="{x:Static loc:Strings.Logs_Copy}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        Command="{Binding CopyCommand}" />
                <Button x:Name="CloseButton" Content="{x:Static loc:Strings.Common_Close}" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
