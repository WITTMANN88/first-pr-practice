<UserControl x:Class="Stakeout.Views.SoftwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Stakeout.Localization;assembly=STAKEOUT.Core"
             xmlns:c="clr-namespace:Stakeout.Controls"
             RenderTransformOrigin="0.5,0.5">
    <UserControl.RenderTransform><TranslateTransform x:Name="Slide" Y="15" /></UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y"
                                     From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.Software_Title}" Style="{StaticResource H1}" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="300" Height="180" Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- vector logo (DrawingImage from Themes/Logos.xaml, no files) -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Image Width="44" Height="44" Stretch="Uniform"
                                           Source="{Binding LogoKey, Converter={StaticResource ResourceKeyToImage}}" />
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource H2}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        <TextBlock Text="{Binding MethodText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- morphing status text -->
                                <TextBlock Grid.Row="1" Text="{Binding StageText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding StageText, Converter={StaticResource StringToVis}}" />

                                <!-- rounded progress bar with a running highlight -->
                                <Grid Grid.Row="2" Height="10" Margin="0,0,0,10"
                                      Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Style="{StaticResource RoundedProgress}"
                                                 Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                 IsIndeterminate="{Binding IsIndeterminate}" />
                                    <!-- Running highlight; only animates while this bar is visible
                                         (i.e. while installing). Also signals activity for winget,
                                         which reports no byte progress. -->
                                    <c:ShimmerOverlay CornerRadius="5" />
                                </Grid>

                                <!-- Install (auto-disables while running) / Cancel while busy. -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <Button Content="{x:Static loc:Strings.Software_Install}" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding InstallCommand}"
                                            Visibility="{Binding Busy, Converter={StaticResource InverseBoolToVis}}" />
                                    <Button Content="{x:Static loc:Strings.Common_Cancel}" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding CancelCommand}"
                                            Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
