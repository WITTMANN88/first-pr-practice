<Window x:Class="Stakeout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Stakeout.Localization;assembly=STAKEOUT.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Stakeout.ViewModels"
        xmlns:views="clr-namespace:Stakeout.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:design="clr-namespace:Stakeout.Design"
        mc:Ignorable="d"
        d:DataContext="{x:Static design:DesignData.Main}"
        Title="STAKEOUT" Height="720" Width="1100"
        MinWidth="900" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FF000000" Foreground="#DEFFFFFF"
        FontFamily="{StaticResource BodyFont}">

    <!-- Custom chrome: no white frame, sharp corners, our own caption bar. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- Map page view models to their views. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SysInfoViewModel}"><views:SysInfoView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}"><views:TweaksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UwpViewModel}"><views:UwpView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SoftwareViewModel}"><views:SoftwareView /></DataTemplate>

        <!-- Hand-drawn Cthulhu tentacle pattern, tiled at 5% opacity. -->
        <DrawingBrush x:Key="CthulhuPattern" TileMode="Tile" Opacity="0.05"
                      Viewport="0,0,180,180" ViewportUnits="Absolute" Stretch="Uniform">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFFFF" Thickness="1.4" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <!-- a coiled tentacle -->
                            <PathFigure StartPoint="20,90">
                                <BezierSegment Point1="40,20" Point2="120,20" Point3="140,90" />
                                <BezierSegment Point1="150,130" Point2="110,150" Point3="95,120" />
                                <BezierSegment Point1="88,105" Point2="105,95" Point3="112,108" />
                            </PathFigure>
                            <!-- suckers -->
                            <PathFigure StartPoint="60,60"><ArcSegment Point="60,61" Size="6,6" IsLargeArc="True" /></PathFigure>
                            <PathFigure StartPoint="90,50"><ArcSegment Point="90,51" Size="5,5" IsLargeArc="True" /></PathFigure>
                            <PathFigure StartPoint="120,70"><ArcSegment Point="120,71" Size="6,6" IsLargeArc="True" /></PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <!-- Root. Maximized size is held to the monitor work area in code
         (Infrastructure/MaximizedWindowHook), so no edge padding is needed. -->
    <Grid>
        <!-- Background pattern overlay -->
        <Rectangle Fill="{StaticResource CthulhuPattern}" IsHitTestVisible="False" />

        <!-- ===== Main interface (revealed after the splash) ===== -->
        <!-- d:Opacity: the designer shows the revealed shell, not the pre-splash state. -->
        <Grid x:Name="Shell" Opacity="0" d:Opacity="1" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="ShellScale" ScaleX="0.98" ScaleY="0.98" /></Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#FF080808">
                <TextBlock Text="STAKEOUT" FontFamily="{StaticResource HeadingFont}"
                           FontSize="16" FontWeight="Bold" Foreground="#DEFFFFFF"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinBtn" Content="—" Width="44" Click="OnMinimize" Style="{StaticResource CaptionBtn}"
                            ToolTip="{x:Static loc:Strings.Caption_Minimize}" AutomationProperties.Name="{x:Static loc:Strings.Caption_Minimize}" />
                    <Button x:Name="MaxBtn" Content="▢" Width="44" Click="OnMaximize" Style="{StaticResource CaptionBtn}"
                            ToolTip="{x:Static loc:Strings.Caption_Maximize}" AutomationProperties.Name="{x:Static loc:Strings.Caption_Maximize}" />
                    <Button x:Name="CloseBtn" Content="✕" Width="44" Click="OnClose" Style="{StaticResource CaptionBtn}"
                            ToolTip="{x:Static loc:Strings.Common_Close}" AutomationProperties.Name="{x:Static loc:Strings.Common_Close}" />
                </StackPanel>
            </Grid>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Grid.Row="1" Grid.Column="0" Width="220" Background="#FF080808">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- hamburger -->
                    <Button Grid.Row="0" HorizontalAlignment="Left" Margin="14,10"
                            Command="{Binding ToggleSidebarCommand}" Style="{StaticResource CaptionBtn}"
                            Width="36" Height="36" Content="≡" FontSize="18"
                            ToolTip="{x:Static loc:Strings.Nav_Menu}" AutomationProperties.Name="{x:Static loc:Strings.Nav_Menu}" />

                    <!-- nav: each button is checked from, and checks, MainViewModel.Selected,
                         so mouse, keyboard and UI Automation all switch the page.
                         Named for screen readers; tooltips only while collapsed to icons. -->
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding Selected, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=SysInfo}"
                                     AutomationProperties.Name="{x:Static loc:Strings.Nav_System}"
                                     ToolTip="{x:Static loc:Strings.Nav_System}"
                                     ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.6" Data="M2,3 H18 V13 H2 Z M7,17 H13 M10,13 V17" />
                                <TextBlock Text="{x:Static loc:Strings.Nav_System}" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding Selected, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Tweaks}"
                                     AutomationProperties.Name="{x:Static loc:Strings.Nav_Tweaks}"
                                     ToolTip="{x:Static loc:Strings.Nav_Tweaks}"
                                     ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.6" Data="M3,5 H17 M3,10 H17 M3,15 H17 M7,5 A1.6,1.6 0 1 0 7,5.01 M13,10 A1.6,1.6 0 1 0 13,10.01 M9,15 A1.6,1.6 0 1 0 9,15.01" />
                                <TextBlock Text="{x:Static loc:Strings.Nav_Tweaks}" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding Selected, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Uwp}"
                                     AutomationProperties.Name="{x:Static loc:Strings.Nav_Apps}"
                                     ToolTip="{x:Static loc:Strings.Nav_Apps}"
                                     ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.6" Data="M3,3 H8 V8 H3 Z M12,3 H17 V8 H12 Z M3,12 H8 V17 H3 Z M12,12 H17 V17 H12 Z" />
                                <TextBlock Text="{x:Static loc:Strings.Nav_Apps}" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                     IsChecked="{Binding Selected, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Software}"
                                     AutomationProperties.Name="{x:Static loc:Strings.Nav_Install}"
                                     ToolTip="{x:Static loc:Strings.Nav_Install}"
                                     ToolTipService.IsEnabled="{Binding IsSidebarCollapsed}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.6" Data="M10,2 V12 M6,9 L10,13 L14,9 M3,16 H17" />
                                <TextBlock Text="{x:Static loc:Strings.Nav_Install}" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- bottom block: log viewer, then the hidden "revert all" -->
                    <StackPanel Grid.Row="2">
                        <Button Style="{StaticResource SideActionButton}" Command="{Binding Logs.OpenCommand}"
                                ToolTip="{x:Static loc:Strings.Nav_LogsTooltip}"
                                AutomationProperties.Name="{x:Static loc:Strings.Nav_Logs}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.6"
                                      Data="M5,2 H13 L17,6 V18 H5 Z M13,2 V6 H17 M8,10 H14 M8,13 H14 M8,16 H12" />
                                <TextBlock Text="{x:Static loc:Strings.Nav_Logs}" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </Button>

                        <!-- hidden "revert all", double-click only -->
                        <Border x:Name="RevertAll" Height="44" Background="#FF3A0A0A"
                                Cursor="Hand" MouseLeftButtonDown="OnRevertAllClick" ToolTip="{x:Static loc:Strings.Nav_RevertAllTooltip}">
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       Text="{x:Static loc:Strings.Nav_RevertAll}"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content host -->
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- ===== Log viewer modal (in-app overlay) =====
             Above the shell, below toasts (so "copied" toasts show on top), and
             offset below the 40px title bar so the caption buttons stay usable.
             Visibility / opacity / scale are animated from code-behind
             (AnimateLogOverlay) off LogViewerViewModel.IsOpen. -->
        <Grid x:Name="LogOverlay" Margin="0,40,0,0" Visibility="Collapsed" Opacity="0"
              DataContext="{Binding Logs}">
            <!-- dim backdrop; click outside the panel closes -->
            <Border Background="#D9000000" MouseLeftButtonDown="OnLogBackdropClick" />

            <Grid x:Name="LogPanel" MaxWidth="900" MaxHeight="600" Margin="40"
                  RenderTransformOrigin="0.5,0.5"
                  KeyboardNavigation.TabNavigation="Cycle"
                  KeyboardNavigation.ControlTabNavigation="Cycle"
                  KeyboardNavigation.DirectionalNavigation="Contained">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LogPanelScale" ScaleX="0.96" ScaleY="0.96" />
                        <TranslateTransform x:Name="LogPanelShift" Y="12" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Shadow on a static sibling: its effect output is cached and is
                     not re-rasterized while the log list scrolls. -->
                <Border Background="#FF0D0D0D">
                    <Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.85" /></Border.Effect>
                </Border>

                <views:LogViewerView x:Name="LogView" />
            </Grid>
        </Grid>

        <!-- ===== Toast host (bottom-right) ===== -->
        <ItemsControl ItemsSource="{Binding Toasts}" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                      Margin="0,0,20,20" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FF141414" BorderThickness="0,0,0,3"
                            BorderBrush="{Binding Kind, Mode=OneTime, Converter={StaticResource NotificationKindToBrush}}"
                            Padding="16,10" Margin="0,6,0,0" MinWidth="220"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><TranslateTransform X="0" /></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.7" /></Border.Effect>
                        <TextBlock Text="{Binding Message, Mode=OneTime}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <!-- Error toasts shake on appearance. -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="Error">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.X">
                                                        <LinearDoubleKeyFrame Value="-8" KeyTime="0:0:0.04" />
                                                        <LinearDoubleKeyFrame Value="8"  KeyTime="0:0:0.12" />
                                                        <LinearDoubleKeyFrame Value="-6" KeyTime="0:0:0.20" />
                                                        <LinearDoubleKeyFrame Value="6"  KeyTime="0:0:0.28" />
                                                        <LinearDoubleKeyFrame Value="0"  KeyTime="0:0:0.36" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Startup splash: skull + spear ===== -->
        <!-- Hidden in the designer so the shell underneath is visible. -->
        <Grid x:Name="Splash" Background="#FF000000" d:Visibility="Collapsed">
            <Viewbox Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="200" Height="200">
                    <!-- cranium (no lower jaw) -->
                    <Path Fill="#FFFFFFFF" Data="M100,20
                        C55,20 35,55 40,95
                        C42,115 55,130 70,135
                        L70,150 L85,150 L85,138
                        L115,138 L115,150 L130,150 L130,135
                        C145,130 158,115 160,95
                        C165,55 145,20 100,20 Z" />
                    <!-- eye sockets -->
                    <Ellipse Canvas.Left="62" Canvas.Top="78" Width="26" Height="30" Fill="#FF000000" />
                    <Ellipse Canvas.Left="112" Canvas.Top="78" Width="26" Height="30" Fill="#FF000000" />
                    <!-- nasal cavity -->
                    <Path Fill="#FF000000" Data="M100,110 L92,128 L108,128 Z" />
                    <!-- teeth gaps -->
                    <Rectangle Canvas.Left="90" Canvas.Top="138" Width="2" Height="12" Fill="#FF000000" />
                    <Rectangle Canvas.Left="99" Canvas.Top="138" Width="2" Height="12" Fill="#FF000000" />
                    <Rectangle Canvas.Left="108" Canvas.Top="138" Width="2" Height="12" Fill="#FF000000" />
                    <!-- spear through the skull -->
                    <Line X1="30" Y1="170" X2="175" Y2="35" Stroke="#FFFFFFFF" StrokeThickness="5" />
                    <Polygon Points="175,35 168,52 185,45" Fill="#FFFFFFFF" />
                    <Line X1="35" Y1="168" X2="45" Y2="178" Stroke="#FFFFFFFF" StrokeThickness="5" />
                </Canvas>
            </Viewbox>
            <TextBlock Text="STAKEOUT" FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="Bold"
                       Foreground="#DEFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,240,0,0" />
        </Grid>
    </Grid>
</Window>
