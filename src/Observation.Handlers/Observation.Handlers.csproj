<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Observation.Handlers</RootNamespace>
  </PropertyGroup>

  <!--
    Процедурные обработчики твиков, которые не описываются одним реестровым
    значением: удаление OneDrive, деблоат Brave/Edge (несколько политик под
    одним тумблером), Discord — аппаратное ускорение (подтверждённый факт из
    diff-теста), запуск пользовательских PowerShell-скриптов. Реализуют
    ITweakHandler (Apply/Verify/Revert) из Observation.Core. Мастер DDU не
    реализован здесь — это многошаговый UI-визард (безопасный режим,
    внешний инструмент), а не атомарная операция движка; появится на этапе
    Observation.App. См. «Архитектура кода» и «Схема твика (JSON)» в плане.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Observation.Core\Observation.Core.csproj" />
  </ItemGroup>

</Project>
