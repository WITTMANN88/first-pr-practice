# STAKEOUT code style and analyzer configuration.
# Enforced at build time (EnforceCodeStyleInBuild + TreatWarningsAsErrors in
# src/Directory.Build.props): a violation fails the build locally and in CI.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
#### Code style ####
# Preferences are plain options; build enforcement comes only from the explicit
# dotnet_diagnostic.IDExxxx.severity lines below (the "option = value:warning"
# shorthand is honoured by the IDE but ignored by the command-line build).

csharp_style_namespace_declarations = file_scoped
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
csharp_prefer_braces = when_multiline
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async
dotnet_style_readonly_field = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
dotnet_code_quality_unused_parameters = non_public

dotnet_diagnostic.IDE0161.severity = warning   # file-scoped namespace
dotnet_diagnostic.IDE0065.severity = warning   # usings outside the namespace
dotnet_diagnostic.IDE0011.severity = warning   # braces for multi-line bodies
dotnet_diagnostic.IDE0055.severity = warning   # formatting
# "this." (IDE0003) and int-vs-Int32 (IDE0049) are IDE-only analyzers: the
# compiler never runs them, so they are preferences above, not build gates.
dotnet_diagnostic.IDE0003.severity = suggestion
dotnet_diagnostic.IDE0049.severity = suggestion
dotnet_diagnostic.IDE0040.severity = warning   # explicit accessibility
dotnet_diagnostic.IDE0036.severity = warning   # modifier order
dotnet_diagnostic.IDE0044.severity = warning   # readonly fields
dotnet_diagnostic.IDE0007.severity = warning   # var
dotnet_diagnostic.IDE0005.severity = warning   # unnecessary using
dotnet_diagnostic.IDE0051.severity = warning   # unused private member
dotnet_diagnostic.IDE0052.severity = warning   # unread private member
dotnet_diagnostic.IDE0059.severity = warning   # unnecessary assignment
dotnet_diagnostic.IDE0060.severity = warning   # unused parameter
dotnet_diagnostic.IDE1006.severity = warning   # naming rules below

# Naming (IDE1006)
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.types_and_members.applicable_kinds = class,struct,enum,delegate,method,property,event
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal
dotnet_naming_rule.types_and_members_pascal.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning

dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static,readonly
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter,local
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_rule.locals_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_camel.style = camel
dotnet_naming_rule.locals_camel.severity = warning

#### Analyzer exceptions (AnalysisMode=All). Each one is a deliberate design decision. ####

# CA2000: handing a disposable to the constructor of its owner (new HttpClient(handler),
# new StreamReader(stream)) transfers ownership; the owner disposes it.
dotnet_code_quality.dispose_ownership_transfer_at_constructor = true

# CA1031 (catch general exception): the app's contract is "every action is
# wrapped, logged and reported; nothing crashes the UI". Catch-all + log is used
# only at those boundaries; narrowing them would let an unexpected WMI/COM/
# PowerShell exception type take the process down.
dotnet_diagnostic.CA1031.severity = none

# CA1062 (validate public arguments): nullable reference types are enabled and
# warnings are errors, so null flow is checked at compile time; CA1062 predates NRT.
dotnet_diagnostic.CA1062.severity = none

# CA1863 (cache CompositeFormat): every format string is a localized resource
# resolved per call; a static cache would pin the first culture seen (tests
# switch cultures). Calls happen on user actions, not in hot loops.
dotnet_diagnostic.CA1863.severity = none

# S1135 (TODO comments): the remaining TODOs mark checks that can only be done
# on a real Windows machine (e.g. RawMouseThrottleDuration's registry path).
# They stay visible as suggestions until verified there.
dotnet_diagnostic.S1135.severity = suggestion

# Generated code (XAML *.g.cs, resx designer) is excluded from analysis.
[*.g.cs]
generated_code = true

# WPF application: continuations must return to the UI thread, so
# ConfigureAwait(false) would be a bug here. The UI-free core library keeps CA2007.
[src/STAKEOUT/**.cs]
dotnet_diagnostic.CA2007.severity = none

[src/STAKEOUT.Tests/**.cs]
# Test names are sentences: Method_Condition_Result.
dotnet_diagnostic.CA1707.severity = none
# xUnit guidance: no ConfigureAwait in tests (xUnit1030).
dotnet_diagnostic.CA2007.severity = none
# Leak tests must force a collection.
dotnet_diagnostic.S1215.severity = none
# Inline expected-value arrays are the readable form in assertions.
dotnet_diagnostic.CA1861.severity = none
